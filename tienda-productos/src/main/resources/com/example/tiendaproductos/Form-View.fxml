<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tiendaproductos.controller.FormController">
    <children>
        <Label alignment="CENTER" contentDisplay="CENTER" text="Formulario" />
        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                
            </rowConstraints>
            <children>
                <Label text="Codigo" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Nombre" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Precio" GridPane.rowIndex="2" />
                <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Stock" GridPane.rowIndex="3" />
                <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <ComboBox fx:id="cbCategoria" promptText="Selecciona categoria" GridPane.rowIndex="4" />
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="4" />


            </children>
        </GridPane>
        <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onGuardar" text="Guardar" />
                <Button mnemonicParsing="false" onAction="#onCancelar" text="Cancelar" />
            </children>
        </HBox>
        <ListView fx:id="listView" prefHeight="200.0" prefWidth="200.0" />
        <Label fx:id="lblMsg" />
    </children>

</VBox>
