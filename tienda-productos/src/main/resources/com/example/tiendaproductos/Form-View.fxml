<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tiendaproductos.controller.FormController">
    <children>
        <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="Formulario" />
        <GridPane prefHeight="161.0" prefWidth="600.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                
            </rowConstraints>
            <children>
                <Label text="Codigo" translateX="12.0" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" prefHeight="26.0" prefWidth="273.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Nombre" translateX="12.0" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Precio" translateX="12.0" GridPane.rowIndex="2" />
                <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Stock" translateX="12.0" GridPane.rowIndex="3" />
                <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <ComboBox fx:id="cbCategoria" promptText="Selecciona categoria" translateX="12.0" GridPane.rowIndex="4" />


            </children>
        </GridPane>
        <HBox prefHeight="47.0" prefWidth="600.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onGuardar" style="-fx-background-color: #90EE90; -fx-border-color: black; -fx-border-width: 1px; -fx-border-radius: 5px;" text="Guardar" translateX="12.0" translateY="7.0" />
                <Button mnemonicParsing="false" onAction="#onCancelar" style="-fx-background-color: #FF7F7F; -fx-border-color: black; -fx-border-width: 1px; -fx-border-radius: 5px;" text="Cancelar" translateX="19.0" translateY="7.0" />
            </children>
        </HBox>
        <ListView fx:id="listView" prefHeight="175.0" prefWidth="600.0" />
        <Label fx:id="lblMsg" />
    </children>

</VBox>
